# ── Crypto Portfolio Tracker — environment variables ───────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Required ───────────────────────────────────────────────────────────────────

# Moralis Web3 API key — https://moralis.io/ (free tier available)
MORALIS_API_KEY=

# Random secret for session cookie signing
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ── Solana (optional) ──────────────────────────────────────────────────────────

# Helius API key — https://helius.dev/ (needed for Solana wallet history)
HELIUS_API_KEY=

# ── Payments / credit top-up (optional) ───────────────────────────────────────

# EVM address that receives top-up transfers (USDT, USDC, DAI)
TREASURY_ADDRESS=

# ── Security (optional) ────────────────────────────────────────────────────────

# Comma-separated list of allowed domains for SIWE sign-in messages
# Leave blank to allow any domain (fine for local dev; set in production)
SIWE_EXPECTED_DOMAINS=

# SHA-256 hash of the admin fund-page password
# Generate: echo -n "yourpassword" | sha256sum
FUND_PASSWORD_HASH=

# ── Swap routing (optional) ────────────────────────────────────────────────────

# Rango Exchange API key — improves swap route quality
# https://app.rango.exchange/settings
RANGO_API_KEY=
